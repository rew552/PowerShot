<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PowerShot - Preview"
    MinWidth="320" MinHeight="240"
    WindowStartupLocation="CenterScreen"
    Background="#1E1E1E"
    Foreground="#F1F1F1"
    ShowInTaskbar="True">

    <Grid>
        <!-- Title bar overlay -->
        <TextBlock x:Name="PreviewTitle"
                   Text=""
                   Foreground="#888888"
                   FontFamily="Yu Gothic UI, Segoe UI"
                   FontSize="11"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="12,8"
                   Panel.ZIndex="1"/>

        <!-- Image with aspect-ratio preserved scaling, scollable if exceeds window -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="4">
            <Viewbox Stretch="Uniform">
                <Image x:Name="PreviewImage"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"/>
            </Viewbox>
        </ScrollViewer>
    </Grid>
</Window>
